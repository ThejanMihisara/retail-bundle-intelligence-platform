# ==========================================
# Root GitIgnore for Combined Repository
# ==========================================

# OS Files
.DS_Store
Thumbs.db
Desktop.ini

# IDEs and Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Main project ignores (handled also by subfolder .gitignores)
**/node_modules/
**/dist/
**/build/
**/.venv/
**/venv/
**/env/
**/__pycache__/
**/*.py[cod]

# Secrets (Do not commit API keys or environment files)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
!**/.env.example
